---
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import maddSetupImg from '../../assets/images/dancingwithdata/madd_setup.jpeg';
import presentationImg from '../../assets/images/dancingwithdata/presentation.jpg';
import watchingImg from '../../assets/images/dancingwithdata/watching_the_watcher.jpeg';
import rawImg from '../../assets/images/dancingwithdata/madd_raw_cropped.png';
import renderedImg from '../../assets/images/dancingwithdata/madd_rendered_cropped.png';
import sophieAnimImg from '../../assets/images/dancingwithdata/sophie_animation.png';
import sophieModelImg from '../../assets/images/dancingwithdata/sophie_model.png';
---
<PageLayout title="Dancing with Data — Alex Sheen">
  <div class="base_padding white_text" style="margin:0 -16px">
    <div class="w3-row base_container_padding">
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:80%">
          <div class="projtitle" style="width:100%">
            Dancing with Data
            <div class="projtext" style="width:100%">
              <br />
              Media Arts &amp; Design Capstone Project<br />
              by Alex Sheen and Kevin Lu<br /><br />
              3rd Place at MADD EXPO23<br />
              <br />
            </div>
          </div>
        </div>
      </div>
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <iframe width="560" height="315"
            src="https://www.youtube.com/embed/REYuRUseZWE?si=ckTp_hb_47lQZRF2"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>

    <div class="w3-row">
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={maddSetupImg} style="width:100%" alt="MADD setup" />
        </div>
        <div class="proj" style="width:100%">
          <Image src={presentationImg} style="width:100%" alt="Presentation" />
        </div>
      </div>
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={watchingImg} style="width:100%" alt="Watching the Watcher" />
        </div>
      </div>
    </div>

    <div class="w3-row">
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={rawImg} style="width:100%" alt="Raw" />
        </div>
      </div>
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={renderedImg} style="width:100%" alt="Rendered" />
        </div>
      </div>
    </div>

    <div class="w3-row">
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={sophieAnimImg} style="width:100%" alt="Sophie Animation" />
        </div>
      </div>
      <div class="w3-half base_container_padding">
        <div class="proj" style="width:100%">
          <Image src={sophieModelImg} style="width:100%" alt="Sophie Model" />
        </div>
      </div>
    </div>
  </div>
</PageLayout>
